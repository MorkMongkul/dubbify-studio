{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Movelo Studio",
  "version": "0.5.3",
  "identifier": "com.movelo.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Movelo Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "Video editor with AI dubbing",
    "publisher": "Movelo",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    },
    "resources": {
      "THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2MzY0QTk1QTAzNjQxRkIKUldUN1FUYWdsVW8yVnNjTlBQdUNQRHdFZGc2NDBLY0Eyd0RjaTU2S1hnZzBrVlNSemp6R0JXaGsK",
      "endpoints": [
        "https://github.com/MorkMongkul/dubbify-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
