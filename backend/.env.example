# All keys are optional — every service degrades to a free/mock fallback.
# Source of truth for every setting: app/core/config.py

# ── Translation (Google AI Studio) ─────────────────────────────
# "gemini" (recommended, needs GEMINI_API_KEY) or "deep" (free Google Translate)
TRANSLATION_BACKEND=gemini
GEMINI_API_KEY=xxx
# GEMINI_MODEL=gemini-2.5-flash-lite

# ── Speech recognition + speaker labels (Gemini) ───────────────
# Audio needs a full multimodal model, separate from the cheap translation model.
# GEMINI_ASR_MODEL=gemini-3.6-flash
# The Assistant chat needs reliable function calling.
# GEMINI_CHAT_MODEL=gemini-3.6-flash

# ── TTS (VoxCPM2 via Gradio / HF Space) ────────────────────────
# A Gradio app URL running VoxCPM (e.g. a Colab notebook's gradio.live URL).
# Leave blank to use the public HF Space fallback below.
VOXCPM2_API_URL=
# Set this blank too (with no GEMINI_API_KEY) for pure mock mode, where silent
# placeholder audio is accepted. With any engine configured, silent fallback
# audio is treated as a failure and never saved as a finished clip.
VOXCPM2_HF_SPACE_FALLBACK=openbmb/VoxCPM-Demo
# How many segments to synthesize at once in a batch/job TTS run. Default 2
# is conservative — raise it and measure wall-clock time + error rate for
# your specific backend before trusting a higher value.
# TTS_BATCH_CONCURRENCY=2

# ── Source separation (vocals / background, HF Space) ──────────
# Default is set in app/core/config.py; override only for a different Space.
# SEPARATION_HF_SPACE=csukuangfj/music-source-separation

# ── Optional ───────────────────────────────────────────────────
# Raises HF rate limits for the separation Space
HF_TOKEN=hf_xxx
# Host names the API answers to (it has no login; other hosts are refused to
# block DNS-rebinding attacks from web pages). Default: 127.0.0.1,localhost
# ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ───────────────────────────────────────────────────
# Leave blank for local SQLite (dev). Postgres/Neon for production:
# DATABASE_URL=postgresql+asyncpg://username:password@host:port/database?ssl=require
DATABASE_URL=
